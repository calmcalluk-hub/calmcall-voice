# Copy these into the calmcall-voice Vercel project's Environment
# Variables (Production) yourself — Claude does not enter secret values
# into any form. See README.md for where each value comes from.

# --- Twilio -----------------------------------------------------------
# Auth Token for the CalmCall Twilio account. Used ONLY to verify the
# X-Twilio-Signature header on inbound webhook requests (never to place
# calls or send anything). Twilio Console -> Account -> API keys & tokens.
TWILIO_AUTH_TOKEN=

# Kept for reference / future use by this project; not currently read by
# any handler, but listed since the task asked for it.
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=

# --- OpenAI -------------------------------------------------------------
# Used to call the Realtime "accept call" REST endpoint, and to open the
# live-call WebSocket bridge that makes tool calling (lead capture,
# transfer, hangup) actually work for the duration of the call.
OPENAI_API_KEY=

# Signing secret for the OpenAI webhook endpoint you register for
# `realtime.call.incoming` (OpenAI dashboard -> Webhooks). Verifies the
# webhook-signature header on inbound requests.
OPENAI_WEBHOOK_SECRET=

# OpenAI project the Realtime SIP connector should route into. Defaults
# to proj_zJO9c3hazOg8RnLAimXDhrud in code if unset, but set it explicitly
# so it's visible in the Vercel dashboard.
OPENAI_PROJECT_ID=proj_zJO9c3hazOg8RnLAimXDhrud

# Optional overrides (defaults are already correct for this project):
# OPENAI_SIP_HOST=sip.api.openai.com
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_REALTIME_VOICE=cedar   # alloy|ash|ballad|coral|echo|sage|shimmer|verse|marin|cedar
# DARREN_INSTRUCTIONS=<override the built-in production prompt entirely, if ever needed>

# --- Darren's identity ---------------------------------------------------
# Spoken in Darren's greeting and used on every lead record. Defaults to
# "CalmCall" if unset - set this per deployment once Darren is fronting a
# specific trade business rather than CalmCall itself.
BUSINESS_NAME=CalmCall

# Only set this once a real destination exists for live transfers (a UK
# mobile as tel:+44..., or a SIP URI for a desk phone/PBX). Leaving it
# unset is the correct default for now - Darren is told not to offer
# transfers rather than promise one that can't happen.
# TRANSFER_TARGET_URI=tel:+441234567890

# --- Lead persistence (Supabase) -----------------------------------------
# Matches CalmCall's existing agreed stack. Use the SAME Supabase project
# CalmCall OS already runs on so leads land alongside everything else -
# see README "Lead persistence" for the table this project expects and how
# to point it at a different/existing table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_LEADS_TABLE=darren_call_leads

# Shared secret protecting POST /api/leads (an internal integration point;
# the live-call bridge itself calls the store directly, not through this
# endpoint - see README). Generate a random 32+ byte value.
INTERNAL_LEADS_API_SECRET=
