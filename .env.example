# Copy these into the calmcall-voice Vercel project's Environment
# Variables (Production) yourself — Claude does not enter secret values
# into any form. See README.md for where each value comes from.

# --- Twilio -----------------------------------------------------------
# Auth Token for the CalmCall Twilio account. Used ONLY to verify the
# X-Twilio-Signature header on inbound webhook requests (never to place
# calls or send anything). Twilio Console -> Account -> API keys & tokens.
TWILIO_AUTH_TOKEN=

# Kept for reference / future use by this project; not currently read by
# any handler, but listed since the task asked for it.
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=

# --- OpenAI -------------------------------------------------------------
# Used to call the Realtime "accept call" REST endpoint.
OPENAI_API_KEY=

# Signing secret for the OpenAI webhook endpoint you register for
# `realtime.call.incoming` (OpenAI dashboard -> Webhooks). Verifies the
# webhook-signature header on inbound requests.
OPENAI_WEBHOOK_SECRET=

# OpenAI project the Realtime SIP connector should route into. Defaults
# to proj_zJO9c3hazOg8RnLAimXDhrud in code if unset, but set it explicitly
# so it's visible in the Vercel dashboard.
OPENAI_PROJECT_ID=proj_zJO9c3hazOg8RnLAimXDhrud

# Optional overrides (defaults are already correct for this project):
# OPENAI_SIP_HOST=sip.api.openai.com
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# DARREN_INSTRUCTIONS=<Darren's real production system prompt, once available>
